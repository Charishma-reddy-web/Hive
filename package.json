{
  "name": "nurturehive",
  "private": true,
  "workspaces": [
    "web",
    "cms"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:cms\"",
    "dev:web": "npm run dev --workspace web",
    "dev:cms": "npm run dev --workspace cms",
    "build": "npm run build --workspace web && npm run build --workspace cms"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
